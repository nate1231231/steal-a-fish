for _, rarity in pairs(RarityConfig.Rarities) do
	table.freeze(rarity)
end
table.freeze(RarityConfig.Rarities)
table.freeze(RarityConfig.Order)

-- RarityConfig.Get("Epic") -> rarity table (or nil)
function RarityConfig.Get(rarityName)
	return RarityConfig.Rarities[rarityName]
end

-- Handy for UI: TextLabel.TextColor3 = RarityConfig.GetColor(fish.rarity)
function RarityConfig.GetColor(rarityName)
	local rarity = RarityConfig.Rarities[rarityName]
	return rarity and rarity.color or Color3.new(1, 1, 1)
end

return RarityConfig
