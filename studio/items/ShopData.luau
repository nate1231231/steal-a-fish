-- Find a gamepass entry from the number Roblox gives you (for example in PromptGamePassPurchaseFinished)
function ShopData.GetGamePassByRobloxId(gamePassId)
	for _, pass in ipairs(ShopData.GamePasses) do
		if pass.gamePassId == gamePassId and gamePassId ~= ShopData.PLACEHOLDER_ID then
			return pass
		end
	end
	return nil
end

-- Find a developer product from receiptInfo.ProductId inside MarketplaceService.ProcessReceipt
function ShopData.GetDevProductByRobloxId(productId)
	for _, product in ipairs(ShopData.DevProducts) do
		if product.productId == productId and productId ~= ShopData.PLACEHOLDER_ID then
			return product
		end
	end
	return nil
end

-- Lists every entry that still has a placeholder id (warn about these before publishing!)
function ShopData.ListPlaceholders()
	local missing = {}
	for _, pass in ipairs(ShopData.GamePasses) do
		if pass.gamePassId == ShopData.PLACEHOLDER_ID then
			table.insert(missing, pass.id)
		end
	end
	for _, product in ipairs(ShopData.DevProducts) do
		if product.productId == ShopData.PLACEHOLDER_ID then
			table.insert(missing, product.id)
		end
	end
	return missing
end

return ShopData
