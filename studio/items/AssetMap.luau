local function toAssetUrl(value)
	if type(value) == "number" and value > 0 then
		return "rbxassetid://" .. tostring(math.floor(value))
	elseif type(value) == "string" and value ~= "" and value ~= "0" then
		if string.find(value, "^rbxassetid://") then
			return value
		end
		return "rbxassetid://" .. value
	end
	return nil
end

--[[
	STEP 2 (automatic): swaps every placeholder for the real ids in `realIds`.
	It runs by itself at the bottom of this file using AssetMap.RealIds, but you can also call it
	with another table, e.g. ids loaded from a DataStore or a second module.
	Returns { swapped = number, missing = { "fish_dilis.mesh", ... } }
]]
function AssetMap.SwapPlaceholders(realIds)
	local report = { swapped = 0, missing = {} }
	realIds = realIds or AssetMap.RealIds
	for textureName in pairs(AssetMap.Textures) do
		local url = toAssetUrl(realIds[textureName])
		if url then
			AssetMap.Textures[textureName] = url
			report.swapped += 1
		elseif AssetMap.Textures[textureName] == PLACEHOLDER then
			table.insert(report.missing, textureName)
		end
	end
	for itemId, entry in pairs(AssetMap.Items) do
		local ids = realIds[itemId] or {}
		for _, slot in ipairs({ "mesh", "icon" }) do
			if entry[slot] ~= nil then
				local url = toAssetUrl(ids[slot])
				if url then
					entry[slot] = url
					report.swapped += 1
				elseif entry[slot] == PLACEHOLDER then
					table.insert(report.missing, itemId .. "." .. slot)
				end
			end
		end
	end
	table.sort(report.missing)
	return report
end

-- ===================================================================== getters (use these in your UI/scripts)
function AssetMap.GetIcon(itemId)
	local entry = AssetMap.Items[itemId]
	return entry and entry.icon or PLACEHOLDER
end

function AssetMap.GetMesh(itemId)
	local entry = AssetMap.Items[itemId]
	return entry and entry.mesh or nil
end

function AssetMap.GetTexture(itemId)
	local entry = AssetMap.Items[itemId]
	return entry and entry.texture and AssetMap.Textures[entry.texture] or nil
end

function AssetMap.IsPlaceholder(assetUrl)
	return assetUrl == nil or assetUrl == PLACEHOLDER
end

-- Everything still missing a real id
function AssetMap.ListMissing()
	return AssetMap.SwapPlaceholders({}).missing
end

--[[ =====================================================================
	STEP 3: build MeshPart templates (Studio edit mode, COMMAND BAR only).
	Run this ONE line in the Command Bar after filling in RealIds:

		require(game.ReplicatedStorage.Items.Modules.AssetMap:Clone()).BuildMeshTemplates()

	(The :Clone() makes Studio re-read the module so your new ids are used.)
	For every item with a real mesh id it creates ReplicatedStorage.Items.Models.<Category>.<itemId>:
	MeshPart, atlas texture applied, pivot at the base, anchored, ItemId attribute. Existing templates
	with the same name are replaced. If ReplicatedStorage.Items.Materials has a SurfaceAppearance
	named FishAtlas or PropsAtlas, it is cloned into the part instead of using TextureID.
]]
function AssetMap.BuildMeshTemplates()
	local RunService = game:GetService("RunService")
	if RunService:IsRunning() then
		warn("AssetMap.BuildMeshTemplates: run this in edit mode from the Command Bar, not during play.")
		return
	end
	local AssetService = game:GetService("AssetService")
	local items = game:GetService("ReplicatedStorage"):FindFirstChild("Items")
	assert(items and items:FindFirstChild("Models"), "Run StudioSetup first (ReplicatedStorage.Items.Models is missing)")
	local models = items.Models
	local materials = items:FindFirstChild("Materials")
	local built, failed = 0, 0

	for itemId, entry in pairs(AssetMap.Items) do
		if entry.mesh and entry.mesh ~= PLACEHOLDER then
			local folder = models:FindFirstChild(entry.category)
			if folder == nil then
				folder = Instance.new("Folder")
				folder.Name = entry.category
				folder.Parent = models
			end
			local numericId = tonumber(string.match(entry.mesh, "%d+"))
			local options = {
				CollisionFidelity = Enum.CollisionFidelity.Box, -- cheapest physics; use Hull for tanks you walk into
				RenderFidelity = Enum.RenderFidelity.Automatic,
			}
			local ok, part = pcall(function()
				return AssetService:CreateMeshPartAsync(Content.fromAssetId(numericId), options)
			end)
			if not ok then -- older Studio builds take the string form
				ok, part = pcall(function()
					return AssetService:CreateMeshPartAsync(entry.mesh, options)
				end)
			end
			if ok and part then
				local old = folder:FindFirstChild(itemId)
				if old then
					old:Destroy()
				end
				part.Name = itemId
				part.Anchored = true
				part.Material = Enum.Material.SmoothPlastic
				part.CanCollide = entry.category == "Tank" or entry.category == "Lock" or entry.category == "BangkaSkin"
				part.CastShadow = entry.category ~= "Fish"
				part.PivotOffset = CFrame.new(0, -part.Size.Y / 2, 0) -- pivot at the base, like the OBJ
				part:SetAttribute("ItemId", itemId)
				local appearance = materials and materials:FindFirstChild(entry.texture)
				if appearance and appearance:IsA("SurfaceAppearance") then
					appearance:Clone().Parent = part
				else
					part.TextureID = AssetMap.Textures[entry.texture]
				end
				part.Parent = folder
				built += 1
			else
				failed += 1
				warn("BuildMeshTemplates: could not create " .. itemId .. ": " .. tostring(part))
			end
		end
	end
	print(("AssetMap.BuildMeshTemplates: %d templates built, %d failed, %d ids still missing"):format(
		built, failed, #AssetMap.ListMissing()))
end

--[[ =====================================================================
	HELPER: collect mesh ids automatically (Studio edit mode, COMMAND BAR only).
	After importing the OBJ files with "Add to Workspace" on, run:

		require(game.ReplicatedStorage.Items.Modules.AssetMap:Clone()).PrintRealIdsFromWorkspace()

	It finds every imported MeshPart named like an item id (fish_dilis, net_basic, ...), reads its
	MeshId and prints a complete RealIds block (keeping ids you already pasted). Copy it over
	AssetMap.RealIds above. Icon and atlas ids still come from Asset Manager > Copy ID.
]]
function AssetMap.PrintRealIdsFromWorkspace()
	local meshIds = {}
	for _, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("MeshPart") then
			local itemId = inst.Name
			if AssetMap.Items[itemId] == nil and inst.Parent then
				itemId = inst.Parent.Name -- the importer may name the Model after the file instead
			end
			local entry = AssetMap.Items[itemId]
			if entry and entry.mesh then
				meshIds[itemId] = tonumber(string.match(inst.MeshId, "%d+"))
			end
		end
	end
	local function current(itemId, slot)
		local ids = AssetMap.RealIds[itemId]
		return (ids and tonumber(ids[slot])) or 0
	end
	local lines = { "AssetMap.RealIds = {" }
	table.insert(lines, ("\tFishAtlas = %d,"):format(tonumber(AssetMap.RealIds.FishAtlas) or 0))
	table.insert(lines, ("\tPropsAtlas = %d,"):format(tonumber(AssetMap.RealIds.PropsAtlas) or 0))
	local itemIds = {}
	for itemId in pairs(AssetMap.Items) do
		table.insert(itemIds, itemId)
	end
	table.sort(itemIds)
	local found = 0
	for _, itemId in ipairs(itemIds) do
		if AssetMap.Items[itemId].mesh then
			if meshIds[itemId] then
				found += 1
			end
			local mesh = meshIds[itemId] or current(itemId, "mesh")
			table.insert(lines, ("\t%s = { mesh = %d, icon = %d },"):format(tostring(itemId), mesh, current(itemId, "icon")))
		else
			table.insert(lines, ("\t%s = { icon = %d },"):format(tostring(itemId), current(itemId, "icon")))
		end
	end
	table.insert(lines, "}")
	print(table.concat(lines, "\n"))
	print(("Found %d imported item meshes in Workspace. Copy the block above over AssetMap.RealIds."):format(found))
end

-- Apply the ids pasted in RealIds as soon as this module loads.
AssetMap.SwapPlaceholders(AssetMap.RealIds)

return AssetMap
