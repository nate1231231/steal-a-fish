--[[
	EconomyBalance  (ModuleScript)
	Put in: ReplicatedStorage > Items > Modules > EconomyBalance

	All the money math in one place: fish income, price curves, rebirth scaling, boost and cash-pack
	prices, and steal time. Clients may require it to SHOW numbers, but only the server should use it
	to CHANGE a player's cash.

	Core formulas
	  fish income    = cashPerSecond * (1 + 0.25 * weightFraction) * starMultiplier * mutationMultiplier
	                   (stars: StarConfig, mutations: MutationData stacking + cap; both optional)
	  base income/s  = sum(best fish up to tank capacity) * tank.incomeMultiplier
	                   * (1 + 0.5 * rebirths) * cashMultiplier * VIP(1.1)
	  net/tank price = RoundNice(base * growth ^ (tier - 2))   (tier 1 is free)
	  rebirth cost   = RoundNice(REBIRTH.baseCost * REBIRTH.costGrowth ^ rebirths)
	  cast time      = 10 / net.catchSpeed seconds

	GENERATED by tools/items/gen_luau.py from tools/items/item_data.py.
	To change numbers, edit item_data.py and re-run the generator (or edit here and keep both in sync).
]]

local FishData = require(script.Parent.FishData)
local NetData = require(script.Parent.NetData)
local TankData = require(script.Parent.TankData)
local LockData = require(script.Parent.LockData)
local BoostData = require(script.Parent.BoostData)
local ShopData = require(script.Parent.ShopData)
local StarConfig = require(script.Parent.StarConfig) -- studio/mutations/shared
local MutationData = require(script.Parent.MutationData) -- studio/mutations/shared
local EventSchedule = require(script.Parent.EventSchedule) -- studio/mutations/shared

local EconomyBalance = {}

-- ===================================================================== tuning knobs
EconomyBalance.BASE_CAST_SECONDS = 10.0 -- seconds per catch with a catchSpeed 1.0 net
EconomyBalance.SELL_SECONDS = 30 -- sell value = cashPerSecond * SELL_SECONDS
EconomyBalance.WEIGHT_BONUS_MAX = 0.25 -- heaviest possible fish earns +25%
EconomyBalance.BASE_STEAL_SECONDS = 3 -- hold time to steal a fish from an undefended base
EconomyBalance.AUTO_NET_SLOWDOWN = 1.5 -- auto-net casts 1.5x slower than casting by hand

-- price = RoundNice(base * growth ^ (tier - 2)); tier 1 is free
EconomyBalance.PRICE_CURVES = {
	Net = { base = 1000, growth = 9.5 },
	Tank = { base = 3100, growth = 13.0 },
}

-- Rebirth: pay cash, lose cash + fish, keep nets/tanks/locks/cosmetics.
EconomyBalance.REBIRTH = {
	baseCost = 12_000_000, -- first rebirth
	costGrowth = 5.0, -- each rebirth costs 5x the previous one
	incomeBonus = 0.5, -- +50% income per rebirth
	luckBonus = 0.1, -- +0.1 luck per rebirth
}

-- ===================================================================== helpers
-- Round to 2 significant digits: 12345 -> 12000, 987 -> 990
function EconomyBalance.RoundNice(x)
	if x <= 0 then
		return 0
	end
	local digits = math.floor(math.log10(x)) + 1
	local step = 10 ^ math.max(digits - 2, 0)
	return math.floor(x / step + 0.5) * step
end

-- Price of a net/tank tier from the curve (matches the price stored in NetData/TankData).
function EconomyBalance.TierPrice(category, tier)
	local curve = EconomyBalance.PRICE_CURVES[category]
	assert(curve, "TierPrice: category must be Net or Tank")
	if tier <= 1 then
		return 0
	end
	return EconomyBalance.RoundNice(curve.base * curve.growth ^ (tier - 2))
end

-- ===================================================================== fish income
-- 0..1: where this weight sits inside the species' range
function EconomyBalance.WeightFraction(fishId, weightKg)
	local fish = FishData.ById[fishId]
	if fish == nil or fish.weightMax <= fish.weightMin then
		return 0
	end
	return math.clamp((weightKg - fish.weightMin) / (fish.weightMax - fish.weightMin), 0, 1)
end

-- ===================================================================== stars & mutations (see MUTATION_MANIFEST.md)
-- Star grade multiplier (1.0 ... 2.0). nil stars (old saves) = 1.
function EconomyBalance.StarMultiplier(stars)
	return StarConfig.GetMultiplier(stars)
end

-- Combined mutation multiplier with MutationData.Rules stacking + hard cap. Empty/nil = 1.
function EconomyBalance.MutationMultiplier(mutationIds)
	return (MutationData.CombineMultipliers(mutationIds))
end

-- Everything that makes ONE fish worth more than its species base (weight bonus not included).
function EconomyBalance.FishValueMultiplier(stars, mutationIds)
	return EconomyBalance.StarMultiplier(stars) * EconomyBalance.MutationMultiplier(mutationIds)
end

-- Income per second for ONE fish, before tank/rebirth/boost multipliers.
-- stars and mutationIds are optional, so old two-argument calls still work.
function EconomyBalance.FishIncome(fishId, weightKg, stars, mutationIds)
	local fish = FishData.ById[fishId]
	if fish == nil then
		return 0
	end
	local bonus = 1 + EconomyBalance.WEIGHT_BONUS_MAX * EconomyBalance.WeightFraction(fishId, weightKg or fish.weightMin)
	local value = fish.cashPerSecond * bonus * EconomyBalance.FishValueMultiplier(stars, mutationIds)
	return math.floor(value * 10 + 0.5) / 10
end

-- Cash for selling one fish.
function EconomyBalance.SellValue(fishId, weightKg, stars, mutationIds)
	return math.floor(EconomyBalance.FishIncome(fishId, weightKg, stars, mutationIds) * EconomyBalance.SELL_SECONDS + 0.5)
end

-- Same as FishIncome, for a saved fish record { id, w, st, mu } (FishSchema)
function EconomyBalance.RecordIncome(record)
	return EconomyBalance.FishIncome(record.id, record.w, record.st, record.mu)
end

-- ===================================================================== rebirths
function EconomyBalance.RebirthMultiplier(rebirths)
	return 1 + EconomyBalance.REBIRTH.incomeBonus * (rebirths or 0)
end

function EconomyBalance.RebirthLuck(rebirths)
	return EconomyBalance.REBIRTH.luckBonus * (rebirths or 0)
end

-- Cost of the NEXT rebirth when you already have `rebirths`.
function EconomyBalance.RebirthCost(rebirths)
	local r = EconomyBalance.REBIRTH
	return EconomyBalance.RoundNice(r.baseCost * r.costGrowth ^ (rebirths or 0))
end

--[[
	Total income per second for a base. Call it on the SERVER with server data:

	EconomyBalance.IncomePerSecond({
		fish = { { id = "fish_bangus", weightKg = 1.2, stars = 3, mutations = { "thunderstorm" } }, ... },
		tankId = "tank_aquarium",
		rebirths = 2,
		cashMultiplier = 2,      -- 2x Cash Potion and/or 2x Cash gamepass (multiply them together)
		vip = true,              -- VIP gamepass +10%
	})
	Fish beyond the tank's capacity are ignored (best fish count first).
]]
function EconomyBalance.IncomePerSecond(params)
	local tank = TankData.ById[params.tankId] or TankData.List[1]
	local incomes = {}
	for _, owned in ipairs(params.fish or {}) do
		table.insert(incomes, EconomyBalance.FishIncome(owned.id, owned.weightKg, owned.stars, owned.mutations))
	end
	table.sort(incomes, function(a, b)
		return a > b
	end)
	local total = 0
	for i = 1, math.min(#incomes, tank.capacity) do
		total += incomes[i]
	end
	local vipPass = ShopData.ById.gp_vip
	local vipMultiplier = (params.vip and vipPass) and vipPass.perks.incomeMultiplier or 1
	return total
		* tank.incomeMultiplier
		* EconomyBalance.RebirthMultiplier(params.rebirths)
		* (params.cashMultiplier or 1)
		* vipMultiplier
end

-- ===================================================================== nets, boosts, shop, stealing
-- Seconds between casts. Auto-net casts are slower than manual casting.
function EconomyBalance.CastSeconds(netId, isAutoNet)
	local net = NetData.ById[netId] or NetData.List[1]
	local seconds = EconomyBalance.BASE_CAST_SECONDS / net.catchSpeed
	if isAutoNet then
		seconds *= EconomyBalance.AUTO_NET_SLOWDOWN
	end
	return seconds
end

-- Boost price scales with income: max(minPrice, income * priceSecondsOfIncome)
function EconomyBalance.BoostPrice(boostId, incomePerSecond)
	local boost = BoostData.ById[boostId]
	assert(boost, "BoostPrice: unknown boost " .. tostring(boostId))
	return math.max(boost.minPrice, EconomyBalance.RoundNice((incomePerSecond or 0) * boost.priceSecondsOfIncome))
end

-- Cash given by a Robux cash pack (grant it inside MarketplaceService.ProcessReceipt only)
function EconomyBalance.CashPackAmount(productId, incomePerSecond)
	local product = ShopData.ById[productId]
	assert(product and product.cashSecondsOfIncome, "CashPackAmount: unknown cash pack " .. tostring(productId))
	return math.max(product.minCash, EconomyBalance.RoundNice((incomePerSecond or 0) * product.cashSecondsOfIncome))
end

-- How long a thief must hold the steal prompt, given the defenses the owner has.
function EconomyBalance.StealSeconds(ownedLockIds)
	local seconds = EconomyBalance.BASE_STEAL_SECONDS
	for _, lockId in ipairs(ownedLockIds or {}) do
		local lock = LockData.ById[lockId]
		if lock then
			seconds += lock.extraStealSeconds
		end
	end
	return seconds
end

-- ===================================================================== world events (EventSchedule + MutationData)
-- Fraction of all time where an event is active (about 0.23 with the default calendar)
function EconomyBalance.EventUptime()
	return EventSchedule.ExpectedUptime()
end

-- Chance that a random cast (at a random moment) gains a mutation, at this luck
function EconomyBalance.MutationChancePerCast(luck)
	local total = 0
	for _, mutation in ipairs(MutationData.List) do
		local activeShare = EventSchedule.EventProbability(mutation.id) * mutation.durationSeconds
			/ EventSchedule.Config.slotSeconds
		local chance = math.min(mutation.chance * (1 + MutationData.Rules.luckChanceBonus * (luck or 0)),
			MutationData.Rules.maxChance)
		total += activeShare * chance
	end
	return total
end

-- Average value multiplier of ONE random catch from stars + mutations (about 1.17 at luck 0).
-- Players keep their best fish, so the tank average is higher (see BalanceTable avgStars).
function EconomyBalance.ExpectedCatchMultiplier(luck)
	local mutationGain = 0
	for _, mutation in ipairs(MutationData.List) do
		local activeShare = EventSchedule.EventProbability(mutation.id) * mutation.durationSeconds
			/ EventSchedule.Config.slotSeconds
		local chance = math.min(mutation.chance * (1 + MutationData.Rules.luckChanceBonus * (luck or 0)),
			MutationData.Rules.maxChance)
		mutationGain += activeShare * chance * (mutation.multiplier - 1)
	end
	return StarConfig.ExpectedMultiplier() * (1 + mutationGain)
end

